# LOCAL DEVELOPMENT ONLY. Never commit real keys or use these defaults in production.
SECRET_KEY=replace-with-a-long-random-secret
DATA_KEY=replace-with-a-Fernet-key
DATABASE_URL=sqlite:///telemed.db
FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://127.0.0.1:5000
PORT=5000
PRODUCTION=0
SEED_DEMO=1
RUN_REMINDERS=0
ENABLE_DEV_PAYMENTS=1
SLOT_HOLD_MINUTES=15

# Chapa: leave blank for local development payment simulation.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# AI provider: choose openai or anthropic. API keys remain on the backend only.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# Private Jitsi JWT configuration. Keep blank locally until a private Jitsi deployment exists.
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=
