# LOCAL DEVELOPMENT. Copy to .env. Never commit .env or paste real keys anywhere else.
SECRET_KEY=replace-with-a-long-random-secret
DATA_KEY=replace-with-a-Fernet-key
DATABASE_URL=sqlite:///telemed.db
FRONTEND_ORIGIN=http://localhost:5173
# Public address of the BACKEND. Chapa calls it for webhooks, so locally use an https tunnel URL or leave as is
# (without a webhook the site still confirms the payment when the patient returns from Chapa).
APP_URL=http://127.0.0.1:5000
PORT=5000
PRODUCTION=0
SEED_DEMO=1
RUN_REMINDERS=1
ENABLE_DEV_PAYMENTS=1
SLOT_HOLD_MINUTES=15

# --- Chapa (https://dashboard.chapa.co > Settings > API). Leave blank for local fake payments. ---
CHAPA_SECRET_KEY=
# The "secret hash" you type into Chapa's webhook settings. Any long random string; must match there.
CHAPA_WEBHOOK_SECRET=

# --- AI chatbot and assistants. OpenAI is the default. ---
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini for OpenAI.
AI_MODEL=
TRANSCRIPTION_MODEL=whisper-1
# Stops a leaked page or a bot from running up your bill: max AI calls per day.
AI_DAILY_CAP=1000
# To use Anthropic instead: AI_PROVIDER=anthropic and set ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
# Required if the key says "not scoped to a workspace" (Anthropic Console > Settings > Workspaces, id looks like wrkspc_...).
# Or simply create a key inside a workspace and leave this blank.
ANTHROPIC_WORKSPACE_ID=

# --- Private video (pick ONE). Without it, joining a room returns a clear "not configured" message. ---
# A) Self-hosted Jitsi with JWT login:
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=
# B) JaaS (8x8): JITSI_APP_ID (vpaas-magic-cookie-...), plus:
JITSI_KID=
JITSI_PRIVATE_KEY=
# Local testing ONLY (ignored when PRODUCTION=1): use a public meet.jit.si room.
ALLOW_PUBLIC_ROOMS=0

# Production only: the first admin account is created from these on first start (then remove them).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# How long a sign-in lasts (it renews each time the site is opened)
TOKEN_DAYS=14
# Gemini is also supported: AI_PROVIDER=gemini and GEMINI_API_KEY=...
