# Copy this file to .env on the server and fill it in. NEVER upload .env to GitHub and never put it in public_html.
APP_NAME="Dr. Feysel Tena Medicine"
APP_ENV=production
APP_DEBUG=false
# The address patients use (no slash at the end). Chapa sends people back here.
APP_URL=https://tena.drfeyselclinic.com
# Created for you by the install script (php artisan key:generate). It also protects clinical text and private photos:
# BACK IT UP somewhere safe. If it is lost, the encrypted data cannot be read again.
APP_KEY=

# MySQL database made in hPanel > Databases. The host is almost always 127.0.0.1 on Hostinger.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
LOG_LEVEL=warning

# --- TEST MODE or LIVE MODE ---
# false = TEST MODE (start here): payments are SIMULATED (a "test payment" button, no money moves) and video can use
#         open test rooms. Fine for trying everything out. Do NOT put real patients on test mode.
# true  = LIVE MODE: only real Chapa payments and private signed video rooms.
# Going live = add the Chapa key + video keys below, set this to true, run: php artisan optimize:clear && php artisan tena:selftest
TENA_PRODUCTION=false

# The clinic website the doctors are copied from (php artisan tena:import-clinic-doctors).
CLINIC_SITE_URL=https://drfeyselclinic.com

# How long a sign-in lasts (days). It renews every time the site is opened.
TOKEN_DAYS=14
# Minutes a chosen time is held while the patient pays.
SLOT_HOLD_MINUTES=15

# --- Chapa (https://dashboard.chapa.co > Settings > API). ---
# Empty = payments are simulated (test mode) or refused (live mode). Paste the key and real Chapa payments start; the simulation turns itself off.
CHAPA_SECRET_KEY=
# The "secret hash" you type into Chapa's webhook settings (any long random text). It must match there.
CHAPA_WEBHOOK_SECRET=

# --- AI help (all optional). Pick ONE provider: openai, anthropic or gemini ---
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
AI_MODEL=
AI_DAILY_CAP=1000

# --- Private video rooms (INSTALL.md, "Video rooms") ---
# A) JaaS by 8x8 (free for 25 monthly users, easiest): fill JITSI_APP_ID, JITSI_KID and the key (file or text)
JITSI_APP_ID=
JITSI_KID=
# Put the downloaded key file at storage/app/jitsi.pk and use this line (easiest) ...
JITSI_PRIVATE_KEY_FILE=
# ... or paste the whole key on one line with \n between the lines:
JITSI_PRIVATE_KEY=
# B) Self-hosted Jitsi with login tokens: JITSI_DOMAIN, JITSI_APP_ID, JITSI_APP_SECRET
JITSI_DOMAIN=
JITSI_APP_SECRET=
# Test mode only: use open meet.jit.si rooms when none of the above is set.
ALLOW_PUBLIC_ROOMS=true

# --- Notification email: use EITHER Brevo OR the Hostinger mailbox (SMTP). Leave empty to send none. ---
MAIL_SENDER="Dr. Feysel Tena Medicine <no-reply@drfeyselclinic.com>"
BREVO_API_KEY=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
